flowchart TD
    %% Module Dependency & Coupling Diagram - SecureExam

    subgraph SecurityCore ["Security Core Infrastructure"]
        Config["core/config.py\n(Environment & Secrets)"]
        Security["core/security.py\n(Argon2id, JWT encode/decode)"]
        RateLimiter["core/rate_limiter.py\n(SlowAPI sliding window)"]
        Sanitization["core/sanitizer.py\n(Bleach XSS filter)"]
        AuditLogging["core/audit_logger.py\n(Tamper-evident event emitter)"]
    end

    subgraph DatabaseLayer ["Database Models & Sessions"]
        DBModel_User["models/user.py"]
        DBModel_Exam["models/exam.py"]
        DBModel_Question["models/question.py"]
        DBModel_Attempt["models/attempt.py"]
        DBModel_Result["models/result.py"]
        DBModel_Audit["models/audit.py"]
        DBSession["database/session.py"]
    end

    subgraph Services ["Service Domain Layer"]
        Svc_Auth["services/auth_service.py"]
        Svc_Exam["services/exam_service.py"]
        Svc_Question["services/question_service.py"]
        Svc_Attempt["services/attempt_service.py"]
        Svc_Evaluation["services/evaluation_service.py"]
        Svc_Admin["services/admin_service.py"]
    end

    subgraph Routers ["API Controller Layer"]
        Router_Auth["api/v1/auth.py"]
        Router_Exams["api/v1/exams.py"]
        Router_Questions["api/v1/questions.py"]
        Router_Attempts["api/v1/attempts.py"]
        Router_Results["api/v1/results.py"]
        Router_Admin["api/v1/admin.py"]
    end

