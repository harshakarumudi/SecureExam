# SecureExam Environment Variables Example
# DO NOT commit real secrets or .env to version control

# Security & Cryptography
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Production / Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://secureexam_user:secureexam_secure_pass@localhost:5432/secureexam_db
# Local SQLite fallback for instant offline development:
# DATABASE_URL=sqlite+aiosqlite:///./secureexam.db

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Controls
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# Application Environment
ENVIRONMENT=development
DEBUG=false
